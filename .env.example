# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# CORS (configure allowed origins for API access)
CORS_ORIGIN=http://localhost:5173

# OAuth - Google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3333/api/v1/auth/google/callback

# Frontend URL (for redirects)
FRONTEND_URL=http://localhost:5173

# IA (cada usuario configura su propia API key de Gemini en Ajustes)
# Modelo de Google Gemini usado para el autocompletado con IA
GEMINI_MODEL=gemini-2.0-flash

# Database
DB_CONNECTION=sqlite
DATABASE_URL=./tmp/db.sqlite3
# For PostgreSQL:
# DB_CONNECTION=pg
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=postgres
# PG_PASSWORD=password
# PG_DB_NAME=internships

# Cache (opcional). Sin Upstash configurado usa cache en memoria con TTL.
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
